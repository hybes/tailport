<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders the app's windows off-screen in fixed states and saves PNGs, for visual review. macOS and Linux only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tailport.App\Tailport.App.csproj" />
  </ItemGroup>

</Project>
