<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tailport.App</RootNamespace>
    <AssemblyName>Tailport</AssemblyName>
    <ApplicationIcon>Assets\tailport.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version Condition="'$(TailportVersion)' != ''">$(TailportVersion)</Version>
  </PropertyGroup>

  <!-- `dotnet publish -r win-x64` produces one compressed Tailport.exe that needs no .NET install. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Release builds record their version; the updater stays off in development builds without it. -->
  <ItemGroup Condition="'$(TailportVersion)' != ''">
    <AssemblyMetadata Include="TailportVersion" Value="$(TailportVersion)" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tailport.Core\Tailport.Core.csproj" />
  </ItemGroup>

</Project>
